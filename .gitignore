## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Files built by Visual Studio
*.dll
*.exe
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
*.ilk
*.pdb
*.cache
*.config
*.manifest
*.builds
*.pidb
*.svclog
*.vsp
*.vspscc

# Others
*.dbmdl
*.bak
*.log

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/

# NuGet
*.nupkg
packages/
# The .nupkg files can be ignored when pushing code to source control.

# MSBuild Binary and Logging
*.binlog

# DotCover
.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Web Essentials
*.less.css
*.less.min.css
*.scss.css
*.scss.min.css

# Publish output
publish/
out/

# Azure
PublishProfiles/

# Others
*.tmp
*.temp
*.DS_Store
Thumbs.db

# dotenv files
*.env
*.env.*

# Certificates
*.pfx
*.p12

# EF Core Migrations snapshot (optional, nếu bạn không muốn ignore thì xoá dòng này)
# Migrations/

# JetBrains Rider
.idea/
